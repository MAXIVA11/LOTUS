<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lotus.Setup</RootNamespace>
    <AssemblyName>LOTUS-Setup</AssemblyName>
    <Description>LOTUS Setup</Description>
    <ApplicationIcon>..\Lotus.App\Assets\lotus.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <StartupObject>Lotus.Setup.Program</StartupObject>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- build.ps1 zips the app and the service into this file before Setup is compiled. -->
    <PayloadZip>$(MSBuildThisFileDirectory)..\..\build\payload.zip</PayloadZip>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lotus.Tests" />
    <Page Include="..\Lotus.App\Theme\Theme.xaml" Link="Theme\Theme.xaml" />
    <Compile Include="..\Lotus.App\Controls\GlitchText.cs" Link="Controls\GlitchText.cs" />
    <Compile Include="..\Lotus.App\Controls\LotusMark.cs" Link="Controls\LotusMark.cs" />
    <Resource Include="..\Lotus.App\Assets\lotus.ico" Link="Assets\lotus.ico" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="Exists('$(PayloadZip)')" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
