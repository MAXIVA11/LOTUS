<Window x:Class="Lotus.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lotus.Ui"
        Title="LOTUS" Width="250" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True">
    <Border Background="{StaticResource B.Black}" BorderBrush="{StaticResource B.Cyan}" BorderThickness="1">
        <StackPanel>
            <Rectangle Height="6" Fill="{StaticResource B.Hazard}" />
            <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                <ui:LotusMark Width="24" Height="24" ShowTile="False" />
                <ui:GlitchText Text="LOTUS" FontSize="22" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StateText" Style="{StaticResource T.Label}" Margin="14,0,14,12" />
            <Button Style="{StaticResource Btn.SmallPrimary}" Content="OPEN LOTUS" Click="OnOpen" Margin="8,0,8,8" />
            <Button Style="{StaticResource Btn.Small}" Content="HIDE NOTIFIER" Click="OnQuit" Margin="8,0,8,12"
                    ToolTip="Stops these notifications until you sign in again. Blocking is not affected." />
        </StackPanel>
    </Border>
</Window>
