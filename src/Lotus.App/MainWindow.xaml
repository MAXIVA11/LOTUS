<Window x:Class="Lotus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lotus.Ui"
        Title="LOTUS" Width="1140" Height="760" MinWidth="1000" MinHeight="680"
        Background="{StaticResource B.Ink}" Foreground="{StaticResource B.Text}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/lotus.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Show" />

        <!-- State chip colours for devices -->
        <Style x:Key="StateChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{StaticResource B.Green}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="trusted">
                    <Setter Property="Background" Value="{StaticResource B.Cyan}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="blocked">
                    <Setter Property="Background" Value="{StaticResource B.Pink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="busy">
                    <Setter Property="Background" Value="{StaticResource B.Yellow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="off">
                    <Setter Property="Background" Value="{StaticResource B.Dim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateBar" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource B.Green}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="trusted">
                    <Setter Property="Fill" Value="{StaticResource B.Cyan}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="blocked">
                    <Setter Property="Fill" Value="{StaticResource B.Pink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="busy">
                    <Setter Property="Fill" Value="{StaticResource B.Yellow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="off">
                    <Setter Property="Fill" Value="{StaticResource B.Dim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="blocked">
                    <Setter Property="Foreground" Value="{StaticResource B.Pink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="off">
                    <Setter Property="Foreground" Value="{StaticResource B.Dim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Type chip colours for the activity list -->
        <Style x:Key="EventChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{StaticResource B.Line}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeKey}" Value="stop">
                    <Setter Property="Background" Value="{StaticResource B.Pink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeKey}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource B.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeKey}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource B.Yellow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeKey}" Value="info">
                    <Setter Property="Background" Value="{StaticResource B.Cyan}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EventChipText" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeKey}" Value="quiet">
                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageTitle" TargetType="ui:GlitchText">
            <Setter Property="FontSize" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <DataTemplate x:Key="BulletLine">
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="&gt;" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Pink}"
                           Margin="0,0,10,0" />
                <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- background -->
        <Rectangle Fill="{StaticResource B.Dots}" IsHitTestVisible="False" />
        <ui:LotusMark ShowTile="False" Width="560" Height="560" Opacity="0.045" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="0,0,-90,-120" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ title bar ============ -->
            <Grid Background="{StaticResource B.Black}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ui:LotusMark Width="28" Height="28" ShowTile="False" />
                    <ui:GlitchText Text="LOTUS" FontSize="24" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="//  LOCAL OPERATIONAL TRUSTED USB SYSTEM" Style="{StaticResource T.Label}"
                               VerticalAlignment="Center" Margin="16,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource T.Label}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3,14,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Chrome}" Content="&#xE921;" Click="OnMinimize"
                            ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Chrome}" Content="&#xE922;"
                            Click="OnMaximize" ToolTip="Maximize" />
                    <Button Style="{StaticResource Btn.ChromeClose}" Content="&#xE8BB;" Click="OnClose"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Grid x:Name="Body" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ left rail ============ -->
                <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                        BorderThickness="0,0,1,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,22,0,0">
                            <RadioButton x:Name="NavControl" Style="{StaticResource Nav.Item}" GroupName="nav"
                                         Tag="01" Content="CONTROL" IsChecked="True" Checked="OnNavigate" />
                            <RadioButton x:Name="NavDevices" Style="{StaticResource Nav.Item}" GroupName="nav"
                                         Tag="02" Content="DEVICES" Checked="OnNavigate" />
                            <RadioButton x:Name="NavTrusted" Style="{StaticResource Nav.Item}" GroupName="nav"
                                         Tag="03" Content="TRUSTED" Checked="OnNavigate" />
                            <RadioButton x:Name="NavActivity" Style="{StaticResource Nav.Item}" GroupName="nav"
                                         Tag="04" Content="ACTIVITY" Checked="OnNavigate" />
                            <RadioButton x:Name="NavAbout" Style="{StaticResource Nav.Item}" GroupName="nav"
                                         Tag="05" Content="ABOUT" Checked="OnNavigate" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="22,0,18,20">
                            <Rectangle Height="6" Fill="{StaticResource B.Hazard}" Margin="-22,0,-18,18" />
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="CONNECTED" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding ConnectedCount}" Style="{StaticResource T.Mono}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="BLOCKED" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding BlockedCount}" Style="{StaticResource T.Mono}"
                                           Foreground="{StaticResource B.Pink}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="TRUSTED" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding TrustedCount}" Style="{StaticResource T.Mono}"
                                           Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="9" Height="9" VerticalAlignment="Center" Margin="0,1,9,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource B.Pink}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GuardOk}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource B.Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Text="{Binding GuardText}" Style="{StaticResource T.Label}"
                                           Foreground="{StaticResource B.Text}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ pages ============ -->
                <Grid Grid.Column="1" Margin="30,22,30,22">

                    <!-- ===== CONTROL ===== -->
                    <Grid x:Name="PageControl">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- notices -->
                        <StackPanel>
                            <Border Background="{StaticResource B.Yellow}" Padding="14,8,14,9" Margin="0,0,0,12"
                                    Visibility="{Binding IsDemo, Converter={StaticResource Show}}">
                                <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource B.Black}"
                                           FontWeight="SemiBold"
                                           Text="Demo mode. The devices are simulated and nothing on this PC is changed." />
                            </Border>
                            <Border Background="{StaticResource B.Pink}" Padding="14,8,14,9" Margin="0,0,0,12"
                                    Visibility="{Binding GuardStopped, Converter={StaticResource Show}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource B.Black}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="LOTUS Guard is stopped, so the policy is not being enforced." />
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Small}" Content="START GUARD"
                                            Click="OnStartGuard" />
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource B.Pink}" Padding="14,8,14,9" Margin="0,0,0,12"
                                    Visibility="{Binding GuardMissing, Converter={StaticResource Show}}">
                                <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource B.Black}"
                                           FontWeight="SemiBold"
                                           Text="LOTUS Guard is not installed, so the policy is not being enforced. Run LOTUS-Setup to install it." />
                            </Border>
                            <Border Background="{StaticResource B.Yellow}" Padding="14,8,14,9" Margin="0,0,0,12"
                                    Visibility="{Binding HasPolicyError, Converter={StaticResource Show}}">
                                <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource B.Black}"
                                           FontWeight="SemiBold" Text="{Binding PolicyErrorText}" />
                            </Border>
                        </StackPanel>

                        <!-- status -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource B.Hazard}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource B.Cyan}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <StackPanel Grid.Column="1" Margin="22,14,0,18">
                                    <TextBlock Text="//  STATUS" Style="{StaticResource T.Label}" />
                                    <ui:GlitchText Text="{Binding HeroTitle}" FontSize="78" HorizontalAlignment="Left"
                                                   Margin="-3,-8,0,-6">
                                        <ui:GlitchText.Style>
                                            <Style TargetType="ui:GlitchText">
                                                <Setter Property="Foreground" Value="{StaticResource B.Dim}" />
                                                <Setter Property="Ghosts" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                        <Setter Property="Ghosts" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:GlitchText.Style>
                                    </ui:GlitchText>
                                    <TextBlock Text="{Binding HeroText}" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,34,0">
                                    <TextBlock Text="MASTER SWITCH" Style="{StaticResource T.Label}"
                                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding DraftArmed}"
                                                  ToolTip="Switches LOTUS on or off. Takes effect when you press Apply." />
                                    <TextBlock Text="{Binding DraftArmedText}" Style="{StaticResource T.Title}"
                                               FontSize="20" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- the two policy settings -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE88E;" FontFamily="{StaticResource F.Icon}" FontSize="20"
                                                   Foreground="{StaticResource B.Cyan}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="REMOVABLE STORAGE" Style="{StaticResource T.CardTitle}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource T.Dim}" Margin="0,4,0,14"
                                               Text="USB drives, external disks, card readers and phones." />
                                    <UniformGrid Columns="3" Margin="-6,0,-6,0">
                                        <RadioButton Style="{StaticResource Seg.Item}" GroupName="storage" Tag="ok"
                                                     Content="ALLOW" IsChecked="{Binding StorageAllow}" />
                                        <RadioButton Style="{StaticResource Seg.Item}" GroupName="storage" Tag="warn"
                                                     Content="READ-ONLY" IsChecked="{Binding StorageReadOnly}" />
                                        <RadioButton Style="{StaticResource Seg.Item}" GroupName="storage" Tag="stop"
                                                     Content="BLOCK" IsChecked="{Binding StorageBlock}" />
                                    </UniformGrid>
                                    <TextBlock Text="{Binding StorageHint}" Style="{StaticResource T.Body}"
                                               Margin="0,14,0,0" MinHeight="62" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE772;" FontFamily="{StaticResource F.Icon}" FontSize="20"
                                                   Foreground="{StaticResource B.Cyan}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="PNP DEVICES" Style="{StaticResource T.CardTitle}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource T.Dim}" Margin="0,4,0,14"
                                               Text="Every other plug and play device on a USB port." />
                                    <UniformGrid Columns="2" Margin="-6,0,-6,0">
                                        <RadioButton Style="{StaticResource Seg.Item}" GroupName="pnp" Tag="ok"
                                                     Content="ALLOW" IsChecked="{Binding PnpAllow}" />
                                        <RadioButton Style="{StaticResource Seg.Item}" GroupName="pnp" Tag="stop"
                                                     Content="TRUSTED ONLY" IsChecked="{Binding PnpBlock}" />
                                    </UniformGrid>
                                    <TextBlock Text="{Binding PnpHint}" Style="{StaticResource T.Body}"
                                               Margin="0,14,0,0" MinHeight="42" />
                                    <CheckBox Style="{StaticResource Check}" Margin="0,8,0,0"
                                              IsChecked="{Binding DraftAllowInput}"
                                              IsEnabled="{Binding InputOptionEnabled}"
                                              ToolTip="{Binding InputHint}">
                                        <TextBlock Text="Keep keyboards and mice working" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- latest activity -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,16" Padding="22,14,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="//  LATEST ACTIVITY" Style="{StaticResource T.Label}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource T.Dim}" Margin="0,10,0,0"
                                           Text="Nothing has happened yet."
                                           Visibility="{Binding NoEvents, Converter={StaticResource Show}}" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                                              Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,12,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="132" />
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource T.Label}"
                                                               Margin="0,3,0,0" />
                                                    <Border Grid.Column="1" Style="{StaticResource EventChip}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding TypeText}"
                                                                   Style="{StaticResource EventChipText}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                               Style="{StaticResource T.Body}" FontSize="13"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- unapplied changes -->
                        <Border Grid.Row="4" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Yellow}"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource B.Hazard}" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingText}" Style="{StaticResource T.Body}"
                                           VerticalAlignment="Center" Margin="16,0,10,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,10,14,12">
                                    <Button Style="{StaticResource Btn.Ghost}" Content="DISCARD" Click="OnDiscard"
                                            Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Btn.Primary}" Content="APPLY" Click="OnApply"
                                            MinWidth="140" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== DEVICES ===== -->
                    <Grid x:Name="PageDevices" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <ui:GlitchText Text="DEVICES" Style="{StaticResource PageTitle}" />
                                <TextBlock Style="{StaticResource T.Dim}"
                                           Text="Everything plugged into a USB port right now, and what the policy does with it." />
                            </StackPanel>
                            <Button x:Name="DemoPlug" Style="{StaticResource Btn.Warn}" Content="PLUG IN A FLASH DRIVE"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnDemoPlug"
                                    Visibility="{Binding IsDemo, Converter={StaticResource Show}}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource T.Dim}" Margin="0,24,0,0"
                                   Text="No USB devices are connected."
                                   Visibility="{Binding NoDevices, Converter={StaticResource Show}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Margin="0,0,-14,0" Padding="0,0,14,0">
                            <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                                                BorderThickness="1" Margin="0,0,0,10" ToolTip="{Binding InstanceId}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Style="{StaticResource StateBar}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Glyph}"
                                                           Style="{StaticResource DeviceGlyph}" />
                                                <StackPanel Grid.Column="2" Margin="0,11,10,12">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Body}"
                                                               FontSize="15.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource B.Text}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Label}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Why}" Style="{StaticResource T.Dim}"
                                                               FontSize="12.5" LineHeight="17" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                            Margin="6,8,14,8">
                                                    <Border Style="{StaticResource StateChip}" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StateText}"
                                                                   Style="{StaticResource ChipText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource T.Label}"
                                                               HorizontalAlignment="Right" Margin="0,6,0,0" />
                                                    <TextBlock Text="BUILT-IN" Style="{StaticResource T.Label}"
                                                               HorizontalAlignment="Right" Margin="0,3,0,0"
                                                               Visibility="{Binding ShowBuiltIn, Converter={StaticResource Show}}" />
                                                    <TextBlock Text="READ-ONLY" Style="{StaticResource T.Label}"
                                                               Foreground="{StaticResource B.Yellow}"
                                                               HorizontalAlignment="Right" Margin="0,3,0,0"
                                                               Visibility="{Binding ShowReadOnly, Converter={StaticResource Show}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Width="158"
                                                            Margin="0,8,10,8">
                                                    <Button Style="{StaticResource Btn.SmallPrimary}" Content="TRUST DEVICE"
                                                            Click="OnTrustDevice" Margin="0,0,0,6"
                                                            ToolTip="{Binding SerialNote}"
                                                            ToolTipService.IsEnabled="{Binding HasSerialNote}"
                                                            Visibility="{Binding CanTrust, Converter={StaticResource Show}}" />
                                                    <Button Style="{StaticResource Btn.Small}" Content="TRUST MODEL"
                                                            Click="OnTrustModel"
                                                            ToolTip="Trusts every device with this vendor and product ID, in any port."
                                                            Visibility="{Binding CanTrust, Converter={StaticResource Show}}" />
                                                    <Button Style="{StaticResource Btn.Small}" Content="REMOVE TRUST"
                                                            Click="OnUntrustDevice"
                                                            Visibility="{Binding IsTrusted, Converter={StaticResource Show}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== TRUSTED ===== -->
                    <Grid x:Name="PageTrusted" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,14">
                            <ui:GlitchText Text="TRUSTED" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource T.Dim}"
                                       Text="Devices on this list are never blocked. Add one from the Devices page while it is plugged in." />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource T.Dim}" Margin="0,24,0,0"
                                   Text="Nothing is trusted yet."
                                   Visibility="{Binding NoTrusted, Converter={StaticResource Show}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Margin="0,0,-14,0" Padding="0,0,14,0">
                            <ItemsControl ItemsSource="{Binding Trusted}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                                                BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Fill="{StaticResource B.Cyan}" />
                                                <StackPanel Grid.Column="1" Margin="18,11,10,12">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Body}"
                                                               FontSize="15.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource B.Text}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Id}" Style="{StaticResource T.Label}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Added}" Style="{StaticResource T.Label}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,8,16,8">
                                                    <Border Style="{StaticResource Chip}" Background="{StaticResource B.Cyan}"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding KindText}"
                                                                   Style="{StaticResource ChipText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ConnectedText}"
                                                               Style="{StaticResource T.Label}"
                                                               HorizontalAlignment="Right" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Style="{StaticResource Btn.Small}" Content="REMOVE"
                                                        Click="OnRemoveTrust" VerticalAlignment="Center"
                                                        Margin="0,0,10,0" Width="120" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== ACTIVITY ===== -->
                    <Grid x:Name="PageActivity" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <ui:GlitchText Text="ACTIVITY" Style="{StaticResource PageTitle}" />
                                <TextBlock Style="{StaticResource T.Dim}"
                                           Text="What LOTUS Guard has seen and done, newest first." />
                            </StackPanel>
                            <Button x:Name="OpenLogButton" Style="{StaticResource Btn.Ghost}" Content="OPEN LOG FOLDER"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenLogFolder" />
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource T.Dim}" Margin="0,24,0,0"
                                   Text="Nothing has happened yet."
                                   Visibility="{Binding NoEvents, Converter={StaticResource Show}}" />
                        <Border Grid.Row="1" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Events}" Focusable="False" Margin="0,6,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,6,16,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="132" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource T.Label}"
                                                           Margin="0,3,0,0" />
                                                <Border Grid.Column="1" Style="{StaticResource EventChip}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding TypeText}"
                                                               Style="{StaticResource EventChipText}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                           Style="{StaticResource T.Body}" FontSize="13" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ===== ABOUT ===== -->
                    <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  Focusable="False" Margin="0,0,-14,0" Padding="0,0,14,0">
                        <StackPanel>
                            <ui:GlitchText Text="ABOUT" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,16" MaxWidth="760"
                                       HorizontalAlignment="Left"
                                       Text="LOTUS decides which USB devices are allowed to work on this computer." />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PROTECTION" Style="{StaticResource T.CardTitle}" />
                                        <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                                   Text="{Binding ProtectionText}" />
                                        <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                                   Text="The policy is kept in a sealed store that only LOTUS Guard can write. If someone edits or deletes it, LOTUS Guard puts its own copy back and notes it in the activity log." />
                                    </StackPanel>
                                    <Button x:Name="PasswordButton" Grid.Column="1" Style="{StaticResource Btn.Ghost}"
                                            Content="{Binding PasswordButtonText}" Click="OnChangePassword"
                                            VerticalAlignment="Top" Margin="20,0,0,0" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="HOW IT BLOCKS" Style="{StaticResource T.CardTitle}" />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                               Text="LOTUS Guard is a Windows service that watches the USB ports. It reads what a device says it is the moment Windows reports it, and switches a device the policy blocks off the way Device Manager does. The device stays off, also after a restart, until the policy allows it or you trust it." />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                               Text="Devices this PC has seen before, and that the policy would block, are marked as switched off while they are unplugged. They are already off when they come back." />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                               Text="Read-only mode uses the removable storage policy built into Windows, so the storage stack itself refuses the write." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="WHAT IT DOES NOT DO" Style="{StaticResource T.CardTitle}" />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                               Text="LOTUS trusts a device by what the device reports: vendor, product, serial number and functions. A device built to copy all of those from a trusted one is treated as that device." />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                               Text="The password and the sealed store stop casual changes. Someone with administrator rights who is determined to remove LOTUS, for example from Safe Mode, can still do so." />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                               Text="LOTUS covers USB ports. It does not manage Bluetooth pairing, Thunderbolt docks or network shares." />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                               Text="Read-only mode covers every removable drive, trusted ones included, because Windows applies it to the whole class of device." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:LotusMark Width="72" Height="72" />
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource T.Mono}">
                                            <Run Text="LOTUS" /><Run Text="  " /><Run Text="{Binding Version, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource T.Label}" Margin="0,4,0,0"
                                                   Text="Local Operational Trusted USB System" />
                                        <TextBlock Style="{StaticResource T.Label}" Margin="0,4,0,0"
                                                   Text="Open source under the MIT License" />
                                        <TextBlock Style="{StaticResource T.Label}" Margin="0,4,0,0"
                                                   Foreground="{StaticResource B.Cyan}"
                                                   Text="github.com/MAXIVA11/LOTUS" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- scanlines over everything -->
        <Rectangle Fill="{StaticResource B.Scanlines}" IsHitTestVisible="False" />

        <!-- ============ confirmation ============ -->
        <Grid x:Name="Overlay" Visibility="Collapsed" Background="#D9000000">
            <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Cyan}" BorderThickness="1">
                <StackPanel>
                    <Rectangle Height="10" Fill="{StaticResource B.Hazard}" />
                    <StackPanel Margin="28,18,28,24">
                        <ui:GlitchText x:Name="OverlayTitle" Text="APPLY POLICY" FontSize="38"
                                       HorizontalAlignment="Left" />
                        <TextBlock x:Name="OverlayIntro" Style="{StaticResource T.Body}" Margin="0,6,0,0" />

                        <StackPanel x:Name="OverlayOff" Margin="0,14,0,0">
                            <TextBlock x:Name="OverlayOffCaption" Style="{StaticResource T.Label}" />
                            <ItemsControl x:Name="OverlayOffList" ItemTemplate="{StaticResource BulletLine}"
                                          Focusable="False" />
                        </StackPanel>

                        <StackPanel x:Name="OverlayUntrusted" Margin="0,14,0,0">
                            <TextBlock x:Name="OverlayUntrustedCaption" Style="{StaticResource T.Label}" />
                            <ItemsControl x:Name="OverlayUntrustedList" ItemTemplate="{StaticResource BulletLine}"
                                          Focusable="False" />
                            <CheckBox x:Name="OverlayCheck" Style="{StaticResource Check}" Margin="0,12,0,0">
                                <TextBlock x:Name="OverlayCheckText" />
                            </CheckBox>
                        </StackPanel>

                        <StackPanel x:Name="OverlayOn" Margin="0,14,0,0">
                            <TextBlock x:Name="OverlayOnCaption" Style="{StaticResource T.Label}" />
                            <ItemsControl x:Name="OverlayOnList" ItemTemplate="{StaticResource BulletLine}"
                                          Focusable="False" />
                        </StackPanel>

                        <Border x:Name="OverlayWarning" BorderBrush="{StaticResource B.Yellow}"
                                BorderThickness="3,0,0,0" Padding="12,2,0,3" Margin="0,16,0,0">
                            <TextBlock x:Name="OverlayWarningText" Style="{StaticResource T.Body}"
                                       Foreground="{StaticResource B.Yellow}" />
                        </Border>

                        <StackPanel x:Name="OverlayPasswords" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel x:Name="OverlayPwCurrentRow">
                                <TextBlock x:Name="OverlayPwCurrentLabel" Text="PASSWORD" Style="{StaticResource T.Label}" />
                                <PasswordBox x:Name="OverlayPwCurrent" Style="{StaticResource Field.Password}"
                                             Margin="0,6,0,12" MaxLength="256" />
                            </StackPanel>
                            <StackPanel x:Name="OverlayPwNewRow">
                                <TextBlock Text="NEW PASSWORD, AT LEAST 8 CHARACTERS" Style="{StaticResource T.Label}" />
                                <PasswordBox x:Name="OverlayPwNew" Style="{StaticResource Field.Password}"
                                             Margin="0,6,0,12" MaxLength="256" />
                            </StackPanel>
                            <StackPanel x:Name="OverlayPwRepeatRow">
                                <TextBlock Text="THE NEW PASSWORD AGAIN" Style="{StaticResource T.Label}" />
                                <PasswordBox x:Name="OverlayPwRepeat" Style="{StaticResource Field.Password}"
                                             Margin="0,6,0,0" MaxLength="256" />
                            </StackPanel>
                            <TextBlock x:Name="OverlayPwError" Style="{StaticResource T.Body}" Margin="0,12,0,0"
                                       Foreground="{StaticResource B.Pink}" FontWeight="SemiBold"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button x:Name="OverlayCancel" Style="{StaticResource Btn.Ghost}" Content="CANCEL"
                                    Click="OnOverlayCancel" Margin="0,0,8,0" IsCancel="True" />
                            <Button x:Name="OverlayConfirm" Style="{StaticResource Btn.Primary}" Content="APPLY"
                                    Click="OnOverlayConfirm" MinWidth="140" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border BorderBrush="{StaticResource B.Line}" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
