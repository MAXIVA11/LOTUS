[Unit]
Description=LOTUS USB device control
Documentation=https://github.com/MAXIVA11/LOTUS
After=local-fs.target systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/lotus daemon
# A daemon that is killed comes back. One that ends on its own, as it does
# when LOTUS is removed, stays down.
Restart=on-failure
RestartSec=1

# /var/lib/lotus holds the encrypted policy, /run/lotus the control socket.
StateDirectory=lotus
StateDirectoryMode=0700
UMask=0077
RuntimeDirectory=lotus
RuntimeDirectoryMode=0700
CacheDirectory=lotus
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/cache/lotus
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# The daemon needs root to flip the kernel's USB switches under /sys and to
# write one udev rule. It needs nothing else, so everything else is taken away.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=-/etc/udev/rules.d
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# A Unix socket for control, a netlink socket to hear the kernel announce devices. No network.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
