<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <RootNamespace>Lotus.Linux.Tests</RootNamespace>
    <AssemblyName>Lotus.Linux.Tests</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="..\..\src\Lotus.Linux\Lotus.Linux.csproj" />
    <!-- The tests of the shared parts run here too, against the copy that is built for Linux.
         The parts of them that need Windows are left out of this build. -->
    <Compile Include="..\Lotus.Tests\ClassifierAndEngineTests.cs" Link="Shared\ClassifierAndEngineTests.cs" />
    <Compile Include="..\Lotus.Tests\CustomTrustTests.cs" Link="Shared\CustomTrustTests.cs" />
    <Compile Include="..\Lotus.Tests\Devices.cs" Link="Shared\Devices.cs" />
    <Compile Include="..\Lotus.Tests\EnforcerTests.cs" Link="Shared\EnforcerTests.cs" />
    <Compile Include="..\Lotus.Tests\JsonAndPolicyTests.cs" Link="Shared\JsonAndPolicyTests.cs" />
    <Compile Include="..\Lotus.Tests\SecurityTests.cs" Link="Shared\SecurityTests.cs" />
    <Compile Include="..\Lotus.Tests\StrictModeTests.cs" Link="Shared\StrictModeTests.cs" />
    <Compile Include="..\Lotus.Tests\ViewAndSummaryTests.cs" Link="Shared\ViewAndSummaryTests.cs" />
  </ItemGroup>
</Project>
